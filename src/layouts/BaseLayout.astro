<!--
  作用：全站全局布局组件（有顶部导航版本）
  - 包含 HTML shell、meta 标签、字体加载
  - 引入全局样式 global.css
  - 包含顶部常驻导航栏 NavBar
  - 包含页脚 Footer
  - 通过 <slot /> 插入各页面的主体内容

  关联文件：
  - src/styles/global.css（全局样式）
  - src/components/global/NavBar.astro（顶部导航）
  - src/components/global/Footer.astro（页脚）
  - src/pages/index.astro（首页使用此布局）
  - src/pages/category/[slug].astro（分类页使用此布局）

  注意：文章详情页不使用此布局，而是使用 ArticleLayout.astro（无顶部导航版）
-->

---
import '../styles/global.css';
import NavBar from '../components/global/NavBar.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  /** 页面标题，用于 <title> 标签和 SEO */
  title?: string;
  /** 页面描述，用于 meta description */
  description?: string;
}

const { title = 'BirdsOnly鸟类科普 - 探索羽翼世界', description = '专注鸟类科普，探索羽翼世界的奇妙。覆盖养鸟日常、观鸟指南、人鸟相处、鸟类保护四大专题。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">







  <head>

 <!-- 谷歌埋点 套上生产环境判断，本地开发不产生测试脏数据 -->   
{import.meta.env.PROD && (
  <>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6W8TF0D6XR"></script>
    <script is:raw>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6W8TF0D6XR');
    </script>
    
    <!-- ===== 百度统计（国内用户统计） ===== -->
     <script is:raw>
      var _hmt = _hmt || [];
      (function() {
          var hm = document.createElement("script");
          hm.src = "https://hm.baidu.com/hm.js?181f34585de069e848be3bb362ea342c";
          var s = document.getElementsByTagName("script")[0]; 
          s.parentNode.insertBefore(hm, s);
          })();
    </script>
 


<!-- ============================================================
  全局埋点工具（事件统计）
  用法：在任意可点击元素上添加两个 data 属性即可自动统计：
    data-track-category="分类"  例如 专题入口 / 专题板块 / 盲盒 / 鸟环
    data-track-action="动作"    例如 click / refresh / open（默认 click）
    data-track-label="标签"     例如 专题名 / 按钮文字 / 鸟名
  统计平台：
    - 百度统计：_hmt.push(['_trackEvent', 分类, 动作, 标签])
    - Google Analytics：gtag('event', 动作, {event_category, event_label})
  本地开发（dev）时统计库未加载，函数自动跳过，不产生脏数据。
  ============================================================ -->
<script is:raw>
  window.trackEvent = function (category, action, label, value) {
    try {
      if (typeof gtag === 'function') {
        gtag('event', action || 'click', {
          event_category: category,
          event_label: label || '',
           value: value || 1

    } catch (e) {}
    try {
      if (window._hmt) {
        // 百度统计第4个参数为可选数值指标，业务不需要可以不传
        if(value !== undefined){
          window._hmt.push(['_trackEvent', category, action || 'click', label || '', value]);
        }else{
          window._hmt.push(['_trackEvent', category, action || 'click', label || '']);
        }
      }
    } catch (e) {}
  };

  // 全局委托监听：点击任何带 data-track-category 的元素自动上报
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('[data-track-category]') : null;
    if (el) {
      window.trackEvent(
        el.getAttribute('data-track-category'),
        el.getAttribute('data-track-action') || 'click',
        el.getAttribute('data-track-label') || ''
      );
    }
  });
</script>

 </>

)}


    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- TODO: 替换为实际 favicon 资源 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 字体加载：Outfit（标题展示）+ Nunito（正文），对齐参考项目 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Nunito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <!-- 顶部常驻导航栏 -->
    <NavBar />

    <!-- 页面主体内容 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 页脚 -->
    <Footer />
  </body>
</html>
